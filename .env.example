# BSEE Production Environment Configuration
# Copy this file to .env and update the values

# Database Configuration
BSEE_DB_PASSWORD=your_secure_db_password_here

# Grafana Configuration
GRAFANA_ADMIN_PASSWORD=your_secure_grafana_password_here

# Application Configuration
BSEE_CONFIG_PATH=/app/config/production.yaml
BSEE_LOG_LEVEL=INFO
BSEE_ENV=production

# Security (generate with: openssl rand -hex 32)
BSEE_SECRET_KEY=your_secret_key_here

# External Services (optional)
REDIS_URL=redis://redis:6379
DATABASE_URL=postgresql://bsee:${BSEE_DB_PASSWORD}@postgres:5432/bsee

# AI Configuration
BSEE_AI_ENABLED=true
BSEE_AI_MODEL_PATH=/app/models
BSEE_AI_LEARNING_ENABLED=true

# Performance
BSEE_MAX_WORKERS=4
BSEE_MEMORY_LIMIT=1GB